{
  "name": "mercatta",
  "version": "1.0.0",
  "description": "Sistema de e-commerce usado como sistema-alvo em projetos de teste de software.",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "test": "npm run test:backend",
    "test:backend": "npm test --prefix backend -- --runInBand",
    "test:e2e": "npm run test:e2e --prefix backend -- --runInBand",
    "test:bdd": "npm run seed && cucumber-js",
    "test:bdd:dry": "cucumber-js --dry-run",
    "test:performance": "cucumber-js --profile performance"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Myoui-sys/mercada.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Myoui-sys/mercada/issues"
  },
  "homepage": "https://github.com/Myoui-sys/mercada#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
