# Porta em que a API vai subir
PORT=3001

# Caminho do arquivo do banco SQLite desta instância.
# Para rodar uma instância isolada por grupo, basta apontar cada uma
# para um arquivo diferente (ex: data/grupo-1.sqlite, data/grupo-2.sqlite...)
DATABASE_PATH=./data/amazon-simulator.sqlite

# Segredo usado para assinar os tokens JWT. Troque em cada instância se quiser
# isolar sessões entre grupos.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=1d

# Origem permitida para requisições do frontend (CORS)
FRONTEND_URL=http://localhost:3000
